# ============================================================================
# ✦ SOKHM ATELIER — Environment Configuration (Coolify VPS + Local Database)
# ============================================================================

# Server Binding (Coolify automatically routes traffic to PORT 3000)
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Local VPS SQLite Database & Persistent Uploads Configuration (Recommended for Coolify)
DB_DRIVER=sqlite
USE_LOCAL_SQLITE=true
# Mount a persistent volume in Coolify to /app/storage so your local DB & uploaded images survive redeployments:
STORAGE_DIR=/app/storage
# Optional explicit SQLite file path override (defaults to ${STORAGE_DIR}/database/sokhm.db):
# SQLITE_DB_PATH=/app/storage/database/sokhm.db

# ============================================================================
# Optional Cloud Serverless Drivers (Leave commented out when using Local VPS DB)
# ============================================================================
# DB_DRIVER=neon
# DATABASE_URL=postgresql://user:pass@ep-example.region.aws.neon.tech/neondb?sslmode=require
#
# DB_DRIVER=turso
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token-here
