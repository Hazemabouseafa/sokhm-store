{
  "version": 2,
  "redirects": [
    { "source": "/admin", "destination": "/admin-sokhm/", "permanent": false },
    { "source": "/admin/", "destination": "/admin-sokhm/", "permanent": false },
    { "source": "/admin.html", "destination": "/admin-sokhm/", "permanent": false },
    { "source": "/dashboard", "destination": "/admin-sokhm/", "permanent": false },
    { "source": "/login", "destination": "/admin-sokhm/login.html", "permanent": false },
    { "source": "/login.html", "destination": "/admin-sokhm/login.html", "permanent": false },
    { "source": "/admin/login", "destination": "/admin-sokhm/login.html", "permanent": false },
    { "source": "/admin/login.html", "destination": "/admin-sokhm/login.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin-sokhm", "destination": "/admin-sokhm/index.html" },
    { "source": "/admin-sokhm/", "destination": "/admin-sokhm/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(js|admin-sokhm/js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }
      ]
    }
  ]
}
